# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# TossPayments (legacy — 롤백용으로 보존, 신규 결제는 PortOne 사용)
NEXT_PUBLIC_TOSSPAYMENTS_CLIENT_KEY=
TOSSPAYMENTS_SECRET_KEY=

# PortOne V2 (카카오페이)
NEXT_PUBLIC_PORTONE_STORE_ID=
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=
PORTONE_API_SECRET=
PORTONE_WEBHOOK_SECRET=

# Solapi 알림톡
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_KAKAO_CHANNEL=
SOLAPI_SENDER_PHONE=
SOLAPI_TEMPLATE_REMIND=
SOLAPI_TEMPLATE_CONFIRM=
SOLAPI_TEMPLATE_WAITLIST_CONFIRM=
SOLAPI_TEMPLATE_WAITLIST_PROMOTED=
SOLAPI_TEMPLATE_WAITLIST_REFUNDED=

# Vercel Cron
CRON_SECRET=

# Analytics (GA4)
NEXT_PUBLIC_GA_ID=

# Meta (페이스북/인스타) 픽셀 — 숫자 15~16자리. 비우면 픽셀을 아예 심지 않는다
NEXT_PUBLIC_META_PIXEL_ID=

# Meta Conversions API (서버 이벤트) — 이벤트 관리자에서 발급한 액세스 토큰.
# 비우면 서버 전송은 no-op이고 브라우저 픽셀만 동작한다
META_CAPI_ACCESS_TOKEN=

# (선택) 이벤트 관리자 > 테스트 이벤트 탭 확인용 코드. 검증 끝나면 반드시 비울 것
META_CAPI_TEST_EVENT_CODE=

# (선택) 'on'이면 해시된 전화번호를 메타로 함께 보내 매칭률을 올린다.
# ⚠️ 개인정보 국외이전에 해당 — 개인정보처리방침에 고지한 뒤에만 켤 것
META_CAPI_INCLUDE_PHONE=
